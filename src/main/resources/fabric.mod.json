{
  "schemaVersion": 1,
  "id": "gsave",
  "version": "${version}",
  "name": "GSave",
  "description": "为单人世界提供类 Git 的存档快照与回滚能力。",
  "authors": [
    "mingdai"
  ],
  "license": "GPL-3.0",
  "contact": {
    "homepage": "https://github.com/md-mingdai/GSave",
    "sources": "https://github.com/md-mingdai/GSave",
    "issues": "https://github.com/md-mingdai/GSave/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.mingdai.savegit.SaveGitMod"
    ],
    "modmenu": [
      "com.mingdai.savegit.compat.SaveGitModMenuIntegration"
    ]
  },
  "mixins": [
    "gsave.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.8",
    "java": ">=21",
    "fabric-api": "*",
    "malilib": ">=0.25.7"
  },
  "suggests": {
    "modmenu": "*"
  }
}
