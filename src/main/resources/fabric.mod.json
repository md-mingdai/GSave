{
  "schemaVersion": 1,
  "id": "gsave",
  "version": "${version}",
  "name": "GSave",
  "description": "为单人世界提供存档快照与回滚能力。",
  "authors": [
    "mingdai"
  ],
  "license": "GPL-3.0",
  "contact": {
    "homepage": "https://github.com/md-mingdai/GSave",
    "sources": "https://github.com/md-mingdai/GSave",
    "issues": "https://github.com/md-mingdai/GSave/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.mingdai.savegit.SaveGitMod"
    ],
    "modmenu": [
      "com.mingdai.savegit.compat.SaveGitModMenuIntegration"
    ]
  },
  "mixins": [
    "gsave.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "${minecraft_range}",
    "java": ">=25",
    "fabric-api": "*",
    "malilib": ">=${malilib_min}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
